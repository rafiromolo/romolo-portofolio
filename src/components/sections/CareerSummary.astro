---
import { getAllCareers } from "../../lib/sanity";
import { toHTML } from "@portabletext/to-html";

const careers = await getAllCareers();
---

<div id="container">
  <main>
    <section id="karir">
      <div class="blob" aria-hidden="true"></div>
      <div class="karir-heading">
        <div>
          <p class="eyebrow">Pengalaman</p>
          <h2>Perjalanan Karir</h2>
        </div>
        <a class="view-all" href="/career">
          Lihat Semua <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <ol class="timeline">
        {
          careers.map((entry) => (
            <li class="timeline-item">
              <div class="marker">
                <span
                  class:list={["dot", { current: entry.isCurrent }]}
                  aria-hidden="true"
                />
              </div>
              <div
                class:list={[
                  "card",
                  "entry-card",
                  { "entry-card--current": entry.isCurrent },
                ]}
              >
                <div class="entry-head">
                  <h2>{entry.role}</h2>
                  {entry.isCurrent && (
                    <span class="badge-current">Saat ini</span>
                  )}
                </div>
                <p class="company">{entry.company}</p>
                <p class="period">{entry.period}</p>

                {entry.details && entry.details.length > 0 && (
                  <ul class="details">
                    {entry.details.map((detail) => (
                      <li set:html={toHTML(detail as any)} />
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</div>

<style>
  #karir {
    position: relative;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    width: 380px;
    height: 380px;
    background: var(--gradient);
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.15;
    top: -10%;
    left: -10%;
    z-index: 0;
    pointer-events: none;
  }

  .karir-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .karir-heading .eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin: 0 0 0.4rem;
  }

  .karir-heading .view-all {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    white-space: nowrap;
    padding-bottom: 0.3rem;
  }

  .company {
    font-weight: 600;
    margin: 0.3rem 0 0.15rem;
  }

  .summary {
    color: var(--color-muted);
    margin: 0;
  }

  @media (max-width: 600px) {
    .timeline-item {
      grid-template-columns: 1.5rem 1fr;
      gap: 0.85rem;
    }
  }
</style>
