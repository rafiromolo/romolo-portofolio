---
import { latestProject } from "../../data/projects";
---

<div id="container">
  <main>
    <section id="project">
      <h2>Project Terbaru</h2>
      <div class="project-grid">
        {
          latestProject.map((project) => (
            <article class="card">
              <a href={`/projects/${project.slug}`}>
                <img src={project.image} alt="" class="card-img" />
              </a>
              <div class="project-body">
                <h3>
                  <a class="title" href={`/projects/${project.slug}`}>
                    {project.title}
                  </a>
                </h3>
                <p>{project.description}</p>
                <div class="tag-container">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <div class="links">
                  <a href={`/projects/${project.slug}`}>Lihat Detail &rarr;</a>
                  {project.liveLink && (
                    <a href={project.liveLink} target="_blank" rel="noopener">
                      Live &rarr;
                    </a>
                  )}
                  {project.repoLink && (
                    <a href={project.repoLink} target="_blank" rel="noopener">
                      Repo &rarr;
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <a href="projects" class="btn-primary-sm btn-project"
        >Lihat Project Lainnya →</a
      >
    </section>
  </main>
</div>

<style>
  #project {
    position: relative;
    overflow: hidden;
  }

  .title {
    text-decoration: none;
    color: var(--color-text);
  }

  .project-grid p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  .btn-project {
    display: block;
    margin: 2rem auto 0;
    width: 18%;
  }

  @media (max-width: 780px) {
    .btn-project {
      width: 32%;
    }
  }

  @media (max-width: 480px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
    .btn-project {
      width: 44%;
    }
  }
</style>
