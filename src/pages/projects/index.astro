---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
---

<Layout title="Projects - Rafi Romolo">
  <section id="project">
    <h1>Projects</h1>
    <p class="intro">
      Daftar lengkap project yang pernah saya kerjakan, baik itu project pribadi
      maupun project untuk klien. Setiap project memiliki deskripsi singkat,
      teknologi yang digunakan, serta link ke versi live dan repositori kode.
    </p>

    <div class="project-grid">
      {
        projects.map((project) => (
          <article class="card">
            <img src={project.image} alt="" class="card-img" />
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tag-container">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <div class="links">
              <a href={project.liveLink} target="_blank" rel="noopener">
                Lihat Live &rarr;
              </a>
              <a href={project.repoLink} target="_blank" rel="noopener">
                Repo &rarr;
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  h1 {
    font-size: 2.5rem;
  }

  .intro {
    color: var(--color-muted);
    /* max-width: 60ch; */
    margin: 0 0 3rem;
  }
</style>
