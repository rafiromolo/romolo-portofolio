---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout
  title={`${project.title} - Rafi Romolo`}
  description={project.description}
>
  <section id="project-detail">
    <p class="eyebrow">Project</p>
    <h1>{project.title}</h1>

    <div class="tech-row">
      {project.tags.map((tech) => <span class="tag">{tech}</span>)}
    </div>

    <div class="links">
      {
        project.liveLink && (
          <a
            class="btn-primary"
            href={project.liveLink}
            target="_blank"
            rel="noopener"
          >
            Lihat Live &rarr;
          </a>
        )
      }
      {
        project.repoLink && (
          <a
            class="btn-secondary"
            href={project.repoLink}
            target="_blank"
            rel="noopener"
          >
            Lihat Repo &rarr;
          </a>
        )
      }
    </div>

    <div class="detail-body">
      <h2>Tentang Project Ini</h2>
      <p>{project.description}</p>
    </div>

    {
      project.gallery && project.gallery.length >= 0 && (
        <div class="gallery">
          <h2>Galeri</h2>
          <div class="gallery-grid">
            {project.gallery.map((img) => (
              <div class="gallery-item">
                <img
                  src={img}
                  alt={`Screenshot tambahan ${project.title}`}
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      )
    }
  </section>
</Layout>

<style>
  h1 {
    font-size: 2.5rem;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .detail-body {
    margin-top: 2rem;
  }

  .detail-body p {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    max-width: 100%;
  }

  .gallery-item {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
</style>
