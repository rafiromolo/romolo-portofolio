    </section>

    <script is:inline id="topics-data" type="application/json" set:html={topicsJson} />

    <script>
        type Topic = {
            _id: string;
            title: string;
            category: string;
        };

        const topics: Topic[] = JSON.parse(
            document.getElementById("topics-data")?.textContent || "[]"
        );

        const categoryEl = document.getElementById('card-category')!;
        const titleEl = document.getElementById('card-title')!;
        const btn = document.getElementById('next-btn')!;

        let deck: Topic[] = [];

        function shuffle(items: Topic[]): Topic[] {
            const arr = [...items];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        btn.addEventListener('click', () => {
            if (topics.length === 0) return;
            if (deck.length === 0) deck = shuffle(topics);

            const card = deck.pop()!;
            categoryEl.textContent = card.category;
            titleEl.textContent = card.title;
        });
    </script>
</Layout>