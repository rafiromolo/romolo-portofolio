---
import Layout from "../../layouts/Layout.astro";
import { careerHistory } from "../../data/career";
---

<Layout title="Perjalanan Karir - Rafi Romolo">
  <section id="career-detail">
    <a href="/#karir" class="back-link">&larr; Kembali ke Homepage</a>

    <p class="eyebrow">Pengalaman</p>
    <h1>Perjalanan Karir</h1>
    <p class="intro">
      Rangkuman lengkap pengalaman kerja saya, dari awal karir sampai posisi
      saat ini.
    </p>

    <ol class="timeline">
      {
        careerHistory.map((entry) => (
          <li class="timeline-item">
            <div class="marker">
              <span
                class:list={["dot", { current: entry.isCurrent }]}
                aria-hidden="true"
              />
            </div>
            <div
              class:list={[
                "card",
                "entry-card",
                { "entry-card--current": entry.isCurrent },
              ]}
            >
              <div class="entry-head">
                <h2>{entry.role}</h2>
                {entry.isCurrent && <span class="badge-current">Saat ini</span>}
              </div>
              <p class="company">{entry.company}</p>
              <p class="period">{entry.period}</p>
              <p class="summary">{entry.summary}</p>

              {entry.details && entry.details.length > 0 && (
                <ul class="details">
                  {entry.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>

<style>
  h1 {
    font-size: 2.5rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .eyebrow {
    margin-top: 0 0 0.4rem;
  }

  .intro {
    color: var(--color-muted);
    max-width: 60ch;
    margin: 0 0 3rem;
  }

  .company {
    font-weight: 600;
    margin: 0.35rem 0 0.15rem;
  }

  .period {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .summary {
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .details {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--color-muted);
    display: grid;
    gap: 0.5rem;
  }

  .details li::marker {
    color: var(--grad-2);
  }
</style>
