---
import "../styles/global.css";
import "../styles/logos.css";
import Header from "../components/layout/Header.astro";
import MinimalHeader from "../components/layout/MinimalHeader.astro";
import NoHeader from "../components/layout/NoHeader.astro";
import Footer from "../components/layout/Footer.astro";
import NoFooter from "../components/layout/NoFooter.astro";

export interface Props {
  title: string;
  description?: string;
  header?: "default" | "minimal" | "none";
  showFooter?: boolean;
}

const {
  title = "Default Title",
  description,
  header = "default",
  showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {header === "default" && <Header />}
    {header === "minimal" && <MinimalHeader />}
    {header === "none" && <NoHeader />}
    <slot />
    {showFooter && <Footer />}
    {!showFooter && <NoFooter />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
